# Copy to .env on the server and adjust values when needed.
APP_ENV=production

# Optional: keep these defaults unless you want a different provider/model.
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_ALLOW_HASHING_FALLBACK=true
RAG_ALLOW_MEMORY_FALLBACK=true

# Model credentials can also be configured from the web UI after deployment.
# Avoid committing real API keys.
