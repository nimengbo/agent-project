APP_ENV=local
DATABASE_URL=postgresql+psycopg://interview:interview@localhost:5432/interview_assistant
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_PATH=runtime/qdrant
MINIO_ENDPOINT=http://localhost:9000
MODEL_CONFIG_PATH=runtime/model_config.json
RAG_COLLECTION_NAME=interview_knowledge_base
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_USE_QDRANT=true
RAG_ALLOW_HASHING_FALLBACK=true
RAG_ALLOW_MEMORY_FALLBACK=true
